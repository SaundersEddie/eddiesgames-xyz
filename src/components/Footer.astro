<script is:inline>
  window.googlefc = window.googlefc || {};
  window.googlefc.callbackQueue = window.googlefc.callbackQueue || [];

  const privacyChoices = document.getElementById("privacy-choices");
  const privacyDivider = document.querySelector(".privacy-divider");

  if (privacyChoices) {
    privacyChoices.addEventListener("click", () => {
      window.googlefc.callbackQueue.push({
        CONSENT_API_READY: () => {
          window.googlefc.showRevocationMessage();
        },
      });
    });

    window.googlefc.callbackQueue.push({
      CONSENT_API_READY: () => {
        if (typeof window.__tcfapi !== "function") return;

        window.__tcfapi("addEventListener", 0, (tcData, success) => {
          const showChoices = Boolean(
            success && tcData && tcData.gdprApplies
          );

          privacyChoices.hidden = !showChoices;

          if (privacyDivider) {
            privacyDivider.hidden = !showChoices;
          }
        });
      },
    });
  }
</script>

