---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SiteHead from "../components/SiteHead.astro";
import "../styles/global.css";

const {
  fullWidth = false,
  title = "Eddies Games",
  description = "Free browser games, daily puzzles, and arcade games from Eddies Games.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead title={title} description={description} />
  </head>

  <body>
    <Header />

    <main class={fullWidth ? "container container--full" : "container"}>
      <slot />
    </main>

    <Footer />
  </body>
</html>
